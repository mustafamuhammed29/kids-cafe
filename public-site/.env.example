# ==============================================================================
# HAVEN KIDS CAFÉ — PUBLIC WEBSITE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for local development or set in Cloudflare/Vercel.
#
# CRITICAL SECURITY INVARIANTS:
# 1. NEVER put SUPABASE_SERVICE_ROLE_KEY into this file.
# 2. NEVER put RESEND_API_KEY or TURNSTILE_SECRET_KEY into this file.
# 3. Only PUBLIC keys with safe client-side access belong here.
# ==============================================================================

# Supabase Frankfurt (eu-central-1)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Cloudflare Turnstile (Public Site Key ONLY)
# Leave blank or omit for local mock development (widget operates in mock bypass mode)
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAAX...
