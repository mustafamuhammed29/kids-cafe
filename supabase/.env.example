# ==============================================================================
# HAVEN KIDS CAFÉ — SUPABASE EDGE FUNCTION SECRETS
# ==============================================================================
# Set these secrets in Supabase via CLI or Dashboard:
#   supabase secrets set TURNSTILE_SECRET_KEY=... RESEND_API_KEY=... ENVIRONMENT=production
#
# CRITICAL SECURITY INVARIANTS:
# 1. NEVER expose these secrets to public-site or admin-dashboard frontend applications!
# 2. In production (ENVIRONMENT=production), Turnstile FAILS CLOSED if TURNSTILE_SECRET_KEY
#    is missing or invalid.
# ==============================================================================

# 1. Environment Mode
# Set to 'production' for live deployment, 'development' for local sandbox testing
ENVIRONMENT=production

# 2. Cloudflare Turnstile Secret Key (Private Server Key)
# Obtain from: Cloudflare Dashboard > Turnstile > [Your Widget] > Secret Key
# Required in production: Missing or invalid key causes all bookings to fail closed.
TURNSTILE_SECRET_KEY=0x4AAAAAAAX...

# 3. Resend API Key (Transactional Email Delivery)
# Obtain from: https://resend.com/api-keys
# Used exclusively server-side to dispatch confirmation emails with private cancellation links.
RESEND_API_KEY=re_123456789...

# 4. Optional: Webhook Secret (For Database Webhooks or Edge Function verification)
WEBHOOK_SECRET=your-random-32-character-secret-string
