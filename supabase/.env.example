# ==============================================================================
# HAVEN KIDS CAFÉ — SUPABASE EDGE FUNCTION SECRETS
# ==============================================================================
# Set these secrets in Supabase via CLI or Dashboard:
#   supabase secrets set TURNSTILE_SECRET_KEY=... RESEND_API_KEY=...
#
# CRITICAL SECURITY INVARIANT:
# NEVER expose these secrets to public-site or admin-dashboard frontend applications!
# ==============================================================================

# 1. Cloudflare Turnstile Secret Key (Server-side validation)
# Obtain from: Cloudflare Dashboard > Turnstile > [Your Widget] > Secret Key
TURNSTILE_SECRET_KEY=0x4AAAAAAAX...

# 2. Resend API Key (Transactional Email Delivery)
# Obtain from: https://resend.com/api-keys
RESEND_API_KEY=re_123456789...

# 3. Optional: Webhook Secret (For Database Webhooks or Edge Function verification)
WEBHOOK_SECRET=your-random-32-character-secret-string

# 4. Environment (development | production)
ENVIRONMENT=production
