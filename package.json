{
  "name": "haven-kids-cafe-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "public-site",
    "admin-dashboard"
  ],
  "scripts": {
    "dev:public": "npm --prefix public-site run dev",
    "dev:admin": "npm --prefix admin-dashboard run dev",
    "build:public": "npm --prefix public-site run build",
    "build:admin": "npm --prefix admin-dashboard run build",
    "build": "npm --prefix public-site run build && npm --prefix admin-dashboard run build",
    "preview:public": "npm --prefix public-site run preview",
    "preview:admin": "npm --prefix admin-dashboard run preview"
  }
}
